{
  "name": "gladys-adax",
  "version": "0.1.0",
  "private": true,
  "description": "External Gladys Assistant integration for Adax WiFi panel heaters through the official Adax API: setpoint, heating on/off, room temperature, power and energy index per room, scene triggers and actions, dashboard widgets.",
  "homepage": "https://github.com/William-De71/gladys-adax",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/William-De71/gladys-adax.git"
  },
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test",
    "coverage": "node --test --experimental-test-coverage"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@gladysassistant/integration-sdk": "^0.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  },
  "license": "Apache-2.0",
  "keywords": [
    "gladys-assistant",
    "gladys-assistant-integration",
    "adax",
    "adax-wifi",
    "panel-heater",
    "heater",
    "thermostat",
    "home-automation"
  ]
}
